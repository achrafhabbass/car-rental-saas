# ============================================
# AutoSphere SaaS - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---- Node Environment ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
POSTGRES_USER=autosphere
POSTGRES_PASSWORD=autosphere_dev_password
POSTGRES_DB=autosphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://autosphere:autosphere_dev_password@localhost:5432/autosphere?schema=public

# ---- API Server ----
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=api/v1
API_CORS_ORIGIN=http://localhost:3000

# ---- JWT Authentication ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_dev_only
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_dev_only
JWT_REFRESH_EXPIRATION=7d

# ---- Multi-Tenant ----
# Header used to pass tenant context (fallback when JWT has no tenant claim)
TENANT_HEADER=x-tenant-id
# Default subdomain strategy: header | subdomain | jwt
TENANT_STRATEGY=jwt

# ---- Web Frontend (Next.js) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=AutoSphere

# ---- Logging ----
LOG_LEVEL=debug

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Sentry (optional — leave DSN empty to disable) ----
# API + Next.js server/edge
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Browser-side Sentry (NEXT_PUBLIC_ vars are baked into the client bundle)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# ---- File uploads (Cloudinary) ----
# Leave CLOUDINARY_CLOUD_NAME empty to disable uploads entirely.
# Get keys at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=autosphere
# 10 MB
UPLOAD_MAX_BYTES=10485760

# ---- Stripe (optional — leave secret key empty to disable billing) ----
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
# Price IDs created in your Stripe dashboard (Products → Pricing).
# Map them to the AutoSphere plans + billing periods:
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Where Stripe redirects after Checkout success/cancel (full URLs):
STRIPE_SUCCESS_URL=http://localhost:3000/settings?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?checkout=cancelled
