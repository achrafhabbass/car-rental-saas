// ============================================
// AutoSphere SaaS - Prisma Schema
// Multi-tenant strategy: shared database, tenant_id filtering
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS - System
// ============================================

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum TenantPlan {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  AGENT
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

// ============================================
// ENUMS - Business
// ============================================

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
}

enum VehicleFuel {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ClientSegment {
  VIP
  REGULAR
  OCCASIONAL
  AT_RISK
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CONVERTED
  NO_SHOW
}

enum ReservationSource {
  DIRECT
  WEBSITE
  PHONE
  PARTNER
  WALK_IN
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DepositMethod {
  CASH
  CHECK
  CARD
  CARD_IMPRINT
  BANK_TRANSFER
}

// ============================================
// SYSTEM MODELS
// ============================================

model Tenant {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(255)
  slug              String       @unique @db.VarChar(100)
  subdomain         String?      @unique @db.VarChar(100)
  status            TenantStatus @default(TRIAL)
  plan              TenantPlan   @default(STARTER)
  billingEmail      String?      @db.VarChar(255)
  phone             String?      @db.VarChar(32)
  country           String?      @db.VarChar(8)
  locale            String       @default("fr") @db.VarChar(8)
  timezone          String       @default("Africa/Casablanca") @db.VarChar(64)
  currency          String       @default("MAD") @db.VarChar(8)
  subscriptionStart DateTime?    @db.Date
  subscriptionEnd   DateTime?    @db.Date
  trialEndsAt       DateTime?
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  users         User[]
  refreshTokens RefreshToken[]
  vehicles      Vehicle[]
  clients       Client[]
  reservations  Reservation[]
  contracts     RentalContract[]

  @@index([status])
  @@index([plan])
  @@map("tenants")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String?    @db.Uuid
  email           String     @db.VarChar(255)
  passwordHash    String     @db.VarChar(255)
  firstName       String     @db.VarChar(120)
  lastName        String     @db.VarChar(120)
  role            UserRole   @default(VIEWER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  mfaSecret       String?    @db.VarChar(255)
  lastLoginAt     DateTime?
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  createdContracts RentalContract[] @relation("CreatedByUser")

  @@unique([tenantId, email], name: "tenant_email_unique")
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tenantId     String?   @db.Uuid
  tokenHash    String    @unique @db.VarChar(255)
  userAgent    String?   @db.VarChar(512)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// BUSINESS MODELS - Phase 1
// ============================================

/// Vehicle: a car in the tenant's fleet.
model Vehicle {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @db.Uuid
  registration         String              @db.VarChar(32)
  brand                String              @db.VarChar(100)
  model                String              @db.VarChar(100)
  year                 Int
  color                String?             @db.VarChar(64)
  category             String?             @db.VarChar(64)
  vin                  String?             @db.VarChar(32)
  transmission         VehicleTransmission @default(MANUAL)
  fuel                 VehicleFuel         @default(PETROL)
  seats                Int                 @default(5)
  status               VehicleStatus       @default(AVAILABLE)
  currentKm            Int                 @default(0)
  purchaseDate         DateTime?           @db.Date
  purchasePrice        Decimal?            @db.Decimal(12, 2)
  dailyRate            Decimal             @db.Decimal(10, 2)
  weeklyRate           Decimal?            @db.Decimal(10, 2)
  monthlyRate          Decimal?            @db.Decimal(10, 2)
  insuranceExpiry      DateTime?           @db.Date
  technicalVisitExpiry DateTime?           @db.Date
  vignetteExpiry       DateTime?           @db.Date
  photos               String[]            @default([])
  notes                String?             @db.Text
  metadata             Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  contracts    RentalContract[]

  @@unique([tenantId, registration])
  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@map("vehicles")
}

/// Client: individual or company renting vehicles.
model Client {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  type           ClientType     @default(INDIVIDUAL)
  fullName       String         @db.VarChar(255)
  companyName    String?        @db.VarChar(255)
  idNumber       String         @db.VarChar(64)
  idType         String?        @db.VarChar(32) // CIN, PASSPORT, RC
  licenseNumber  String?        @db.VarChar(64)
  licenseExpiry  DateTime?      @db.Date
  dateOfBirth    DateTime?      @db.Date
  nationality    String?        @db.VarChar(64)
  phone          String?        @db.VarChar(32)
  email          String?        @db.VarChar(255)
  addressLine1   String?        @db.VarChar(255)
  addressLine2   String?        @db.VarChar(255)
  city           String?        @db.VarChar(120)
  country        String?        @db.VarChar(64)
  blacklisted    Boolean        @default(false)
  blacklistReason String?       @db.Text
  rating         Decimal        @default(0) @db.Decimal(2, 1)
  segment        ClientSegment  @default(REGULAR)
  notes          String?        @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  contracts    RentalContract[]

  @@unique([tenantId, idNumber])
  @@index([tenantId])
  @@index([tenantId, blacklisted])
  @@index([email])
  @@map("clients")
}

/// Reservation: a planned rental that may later convert into a contract.
model Reservation {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  reservationCode String             @db.VarChar(32)
  vehicleId       String             @db.Uuid
  clientId        String             @db.Uuid
  startDate       DateTime
  endDate         DateTime
  pickupLocation  String?            @db.VarChar(255)
  returnLocation  String?            @db.VarChar(255)
  dailyRate       Decimal            @db.Decimal(10, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  status          ReservationStatus  @default(PENDING)
  source          ReservationSource  @default(DIRECT)
  notes           String?            @db.Text
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  cancelledAt     DateTime?
  convertedAt     DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])
  contract RentalContract?

  @@unique([tenantId, reservationCode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([vehicleId, startDate, endDate])
  @@index([clientId])
  @@map("reservations")
}

/// RentalContract: the active rental agreement tied to a vehicle + client.
model RentalContract {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  contractNumber    String         @db.VarChar(32)
  vehicleId         String         @db.Uuid
  clientId          String         @db.Uuid
  reservationId     String?        @unique @db.Uuid
  createdByUserId   String?        @db.Uuid
  startDate         DateTime
  endDate           DateTime
  actualReturnDate  DateTime?
  kmStart           Int
  kmEnd             Int?
  kmAllowance       Int?           // daily km allowance; null = unlimited
  dailyRate         Decimal        @db.Decimal(10, 2)
  totalAmount       Decimal        @db.Decimal(12, 2)
  depositAmount     Decimal        @default(0) @db.Decimal(12, 2)
  depositMethod     DepositMethod?
  depositReference  String?        @db.VarChar(128)
  extraCharges      Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal        @default(0) @db.Decimal(12, 2)
  pickupLocation    String?        @db.VarChar(255)
  returnLocation    String?        @db.VarChar(255)
  additionalDriver  String?        @db.VarChar(255)
  additionalDriverLicense String?  @db.VarChar(64)
  status            ContractStatus @default(DRAFT)
  signatureUrl      String?        @db.VarChar(512)
  signedAt          DateTime?
  notes             String?        @db.Text
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  createdBy   User?        @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  @@unique([tenantId, contractNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([vehicleId, startDate, endDate])
  @@index([clientId])
  @@map("rental_contracts")
}
